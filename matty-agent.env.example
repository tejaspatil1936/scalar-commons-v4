# Configuration for scripts/run-matty-agent.sh (see README-MATTY.md).
#
# On Replit, set these in Tools → Secrets instead of a file. On your own machine
# you may copy this to .env at the repo root (gitignored); values already in the
# environment win over .env. Everything except the key has a working default for
# the public testnet — you only need to set the key.

# ── The agent's key — REQUIRED, and SECRET. Set exactly one. ──
# The 12-word mnemonic from `scripts/run-matty-agent.sh keygen`. Replit Secrets only;
# never commit it, never paste it into a file in the project.
SCALAR_SEED_PHRASE=
# Or: path to a file holding the mnemonic, mode 0600 (for your own machine).
SCALAR_SEED_FILE=

# ── Public testnet endpoints (defaults shown) ──
SCALAR_WS=wss://rpc.scalarnet.io
SCALAR_INDEXER=https://api.scalarnet.io
SCALAR_FAUCET=https://faucet.scalarnet.io
EXPLORER_BASE=https://explorer.scalarnet.io

# ── Agent behaviour (read by examples/reference-agent/src/config.ts) ──
# Stake locked by registration; agents.minStake is 1000 CMN on spec 306.
AGENT_STAKE_CMN=1000
# Heartbeat every N blocks (6 s each); must not exceed 10800.
HEARTBEAT_EVERY_BLOCKS=600
# Capability ids to publish. Leave empty: publishing needs an on-chain identity (~12 CMN deposit).
AGENT_CAPABILITIES=
ACCEPT_UNCATEGORISED=true
# Keep false: true confirms (and so pays for) deliveries without checking them.
AUTO_CONFIRM=false
CLAIM_REWARDS=true
AGENT_NAME=
AGENT_METADATA_URI=
