[Unit]
Description=Scalar Commons 3-validator devnet (alice, bob, charlie)
Documentation=file:///home/dev/scalar-commons-v4/deploy/README.md
# The three services declare PartOf=scalar-devnet.target, so
# `systemctl --user {start,stop,restart} scalar-devnet.target` moves all three
# together. Each is also independently startable for single-node operations.
Wants=scalar-alice.service scalar-bob.service scalar-charlie.service
After=scalar-alice.service scalar-bob.service scalar-charlie.service

[Install]
# Pulled in by default.target, which the systemd --user instance reaches on
# boot because `loginctl enable-linger dev` is set. This is what makes the
# devnet survive a reboot with nobody logged in.
WantedBy=default.target
