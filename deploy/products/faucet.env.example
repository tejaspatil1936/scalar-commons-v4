# Scalar Commons faucet — operator overrides.
# Installed to ~/.config/scalar-commons/faucet.env (0600) by install.sh.
# Every value here overrides the matching Environment= line in
# scalar-faucet.service. Commented-out lines document the unit's default.
#
# This file is the one that holds a signing key, which is why install.sh
# creates it 0600 and never overwrites an existing one.

# HTTP bind address. Loopback only: the rate limits below are per-address and
# per-IP counters held in memory, which is a devnet-grade defence, not a
# public-internet one.
#FAUCET_HOST=127.0.0.1
#FAUCET_PORT=8082

#FAUCET_RPC_ENDPOINT=ws://127.0.0.1:9944

# Signing account. //Ferdie is endowed at genesis and is not a validator, so
# draining it moves no staked funds. It is a well-known dev seed — anything
# beyond a devnet must set a real one here, in this 0600 file, never in the
# unit.
#FAUCET_SEED=//Ferdie
#FAUCET_SS58_FORMAT=42

# Per-request drip, and the balance below which the faucet refuses to drip.
# The reserve is what keeps the faucet from draining its own account to the
# existential deposit and dying mid-drip.
#FAUCET_DRIP_CMN=10
#FAUCET_RESERVE_CMN=1000

# Rate limits. Per-address stops one agent farming the faucet; per-IP stops one
# host farming it across many addresses.
#FAUCET_ADDRESS_MAX_REQUESTS=1
#FAUCET_ADDRESS_WINDOW_MINUTES=60
#FAUCET_IP_MAX_REQUESTS=5
#FAUCET_IP_WINDOW_MINUTES=60

# Only true behind a proxy that overwrites X-Forwarded-For. On a loopback bind
# every request already appears to come from 127.0.0.1, so trusting the header
# lets a caller forge distinct IPs and bypass the per-IP limit entirely.
#FAUCET_TRUST_PROXY=false
