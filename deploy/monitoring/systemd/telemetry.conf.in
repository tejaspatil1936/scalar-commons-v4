# Installed as ~/.config/systemd/user/scalar-@NODE@.service.d/telemetry.conf
# GENERATED by deploy/monitoring/install.sh from deploy/systemd/scalar-@NODE@.service
# — do not edit the installed copy; edit this template or the unit and re-run.
#
# Adds --telemetry-url to the validator so it reports to the self-hosted
# substrate-telemetry shard on 127.0.0.1:8001 (docker-compose.yml).
#
# systemd cannot append arguments to an ExecStart, so a drop-in has to clear it
# (the empty `ExecStart=`) and restate the whole command line. install.sh copies
# that command line verbatim out of the repo unit and appends one flag, which is
# why this is a template and not five hand-written files: hand-copied command
# lines drift the first time someone edits a unit. The flip side is that this
# drop-in pins the command line as of the last install — CHANGE A UNIT, RE-RUN
# deploy/monitoring/install.sh, or the drop-in silently keeps the old flags.
#
# Verbosity 0 is what the upstream telemetry server expects; higher levels add
# per-block chatter the UI does not use. The quotes keep "URL VERBOSITY" a
# single argument, which is what substrate's --telemetry-url parses.
#
# The chainspec's telemetryEndpoints is null, so this is the node's only
# telemetry destination: nothing is reported to telemetry.polkadot.io.

[Service]
ExecStart=
@EXECSTART@ \
    --telemetry-url "ws://127.0.0.1:8001/submit 0"
