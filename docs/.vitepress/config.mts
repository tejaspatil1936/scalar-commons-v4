import { defineConfig } from 'vitepress'

// The chain snapshot the prose is checked against (scripts/check-chain-values.mjs,
// regenerated by `npm run snapshot:chain`). The footer line quotes it; nothing
// in the theme is typed by hand.
import snapshot from '../.chain/snapshot.json'

const SITE_ORIGIN = 'https://scalarnet.io'
const EXPLORER_ORIGIN = 'https://explorer.scalarnet.io'
const REPO = 'https://github.com/tejaspatil1936/scalar-commons-v4'
const DISCLAIMER = 'Testnet — tokens have no value and the chain may be reset.'
