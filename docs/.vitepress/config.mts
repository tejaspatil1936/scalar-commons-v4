import { spawnSync } from 'node:child_process'
import { fileURLToPath } from 'node:url'
import { defineConfig } from 'vitepress'
import { noteContainer } from './theme/note-container'
import { ledgerCodeTheme } from './theme/code-theme'

// Read the chain snapshot so the site can advertise exactly which runtime the
// prose was verified against. `snapshot.json` is regenerated by
// `npm run snapshot:chain` against a live node — see reference/token-model.md.
import snapshot from '../.chain/snapshot.json'

const ROOT = fileURLToPath(new URL('..', import.meta.url))

// The docs are static, so the only figures the theme shows are records: the
// snapshot's provenance, the sidebar's page count and the drift check's
// verdict, all taken here at build time and handed to the theme as data.
// Nothing in the theme is typed by hand.
const check = spawnSync(process.execPath, ['scripts/check-chain-values.mjs'], {
  cwd: ROOT,
  encoding: 'utf8',
})
const checkOutput = `${check.stdout ?? ''}\n${check.stderr ?? ''}`
// `0 pages` when the check passes; otherwise the number of pages its output
// names (its lines read `<page>:<line>: …`).
const driftPages =
  check.status === 0
    ? 0
    : new Set(
        [...checkOutput.matchAll(/^\s+((?:guide|reference)\/[\w-]+\.md|index\.md)(?=:)/gm)].map(
          (m) => m[1],
        ),
      ).size

const sidebar = [
  {
    text: 'Guide',
    items: [
      { text: 'Run a node', link: '/guide/run-a-node' },
      { text: 'Run an agent', link: '/guide/run-an-agent' },
      { text: 'Agent on the public testnet', link: '/guide/run-an-agent-public-testnet' },
      { text: 'Run a validator', link: '/guide/run-a-validator' },
      { text: 'Testnet tester guide', link: '/guide/testnet-tester-guide' },
      { text: 'SDK usage', link: '/guide/sdk' },
      { text: 'Messaging with the SDK', link: '/guide/messaging-sdk' },
    ],
  },
  {
    text: 'Reference',
    items: [
      { text: 'RPC reference', link: '/reference/rpc' },
      { text: 'Token model', link: '/reference/token-model' },
      { text: 'Messages pallet', link: '/reference/messages' },
      { text: 'Message envelope', link: '/reference/messaging' },
    ],
  },
]

export default defineConfig({
  title: 'Scalar Commons',
  description:
    'Coordination infrastructure for autonomous AI agents — node operation, agent SDK, RPC surface and the CMN token model.',
  lang: 'en-US',

  // GitHub Pages publishes the landing page at the site root and these docs one
  // level below it at `/docs` (see .github/workflows/pages.yml), and a *project*
  // Pages site is itself served under `/<repo>/`. VitePress bakes the base
  // prefix into every asset and router URL it emits, so it has to be known at
  // build time — the Pages workflow composes the two segments and passes the
  // result in DOCS_BASE. Everything else (local `npm run build`, the ci-node
  // docs job) sets nothing and keeps the root-relative default it always had.
  base: process.env.DOCS_BASE ?? '/',

  // The site lives in `docs/` alongside pre-existing engineering records that
  // are not part of the published documentation. They stay where they are.
  srcExclude: ['VERIFIED-CONSTANTS.md', 'rfcs/**', 'README.md'],

  // A broken internal link is a documentation bug, so fail the build on one.
  ignoreDeadLinks: false,

  cleanUrls: true,

  // One theme (the Ledger): light only, no dark scheme, no appearance toggle.
  appearance: false,
  head: [
    ['meta', { name: 'color-scheme', content: 'light' }],
    // The Sources switch's memory, applied before first paint (the chrome's key).
    [
      'script',
      {},
      'try{if(localStorage.getItem("observatory:sources")==="1")document.documentElement.setAttribute("data-sources","")}catch(e){}',
    ],
  ],

  markdown: {
    // Code in ink: one Shiki theme whose colours are the Ledger tokens' CSS
    // variables, so the built HTML carries no colour literal (theme/code-theme.ts).
    theme: ledgerCodeTheme,
    config(md) {
      md.use(noteContainer)
    },
  },

  themeConfig: {
    sidebar,
    outline: [2, 3],
    search: { provider: 'local' },

    // The facts the Ledger theme prints; every one a record.
    ledger: {
      chainName: snapshot.chain.name,
      specVersion: snapshot.runtime.specVersion,
      block: snapshot.provenance.capturedAtBlock,
      genesisHash: snapshot.provenance.genesisHash,
      nodeVersion: snapshot.provenance.nodeVersion,
      builtAt: new Date().toISOString(),
      pages: sidebar.reduce((n, g) => n + g.items.length, 0),
      drift: driftPages,
      checkPassed: check.status === 0,
    },
  },
})
