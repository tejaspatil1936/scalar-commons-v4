        text: 'Message privacy: what an operator can read',
        link: `${SITE_ORIGIN}/oversight`,
        ...sameSite,
      },
    ],
  },
]

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')

/**
 * Code blocks carry no syntax colours (SITE-REDESIGN.md §3, "Code block"):
 * every line is plain text in --mono on --bg-2, so the built HTML holds no
 * colour literal and no per-token span. VitePress's wrapper still adds the
 * copy button and the `.line` structure its stylesheet expects.
 */
const plainCode = (code: string): string => {
  const lines = code
    .replace(/\n$/, '')
    .split('\n')
    .map((line) => `<span class="line">${escapeHtml(line)}</span>`)
    .join('\n')
  return `<pre tabindex="0"><code>${lines}</code></pre>`
}

export default defineConfig({
  title: 'Scalar Commons',
  titleTemplate: ':title — Scalar Commons',
  description: DESCRIPTION,
  lang: 'en',

  // The docs are published one level below the site root (`/docs/`); the host
  // passes DOCS_BASE at build time. A plain `npm run build` keeps the root.
  base: process.env.DOCS_BASE ?? '/',

  // The site lives in `docs/` alongside pre-existing engineering records that
  // are not part of the published documentation. They stay where they are.
  srcExclude: ['VERIFIED-CONSTANTS.md', 'rfcs/**', 'README.md'],

  // A broken internal link is a documentation bug, so fail the build on one.
  ignoreDeadLinks: false,

  cleanUrls: true,

  // A page loads what it shows: no idle prefetch of every sidebar page's chunk
  // (SITE-REDESIGN.md §7: at most 12 requests on first load).
  router: { prefetchLinks: false },

  // One theme, light: no dark scheme, no appearance toggle.
  appearance: false,
  head: [
    ['link', { rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml' }],
    ['meta', { property: 'og:type', content: 'website' }],
    ['meta', { property: 'og:site_name', content: 'Scalar Commons' }],
    ['meta', { property: 'og:image', content: `${SITE_ORIGIN}/og.png` }],
    ['meta', { name: 'twitter:card', content: 'summary_large_image' }],
  ],

  // Every page: a canonical URL and its own Open Graph title and description.
  transformPageData(pageData) {
    const path = pageData.relativePath.replace(/(^|\/)index\.md$/, '$1').replace(/\.md$/, '')
    const url = `${SITE_ORIGIN}/docs/${path}`
    const title = pageData.title ? `${pageData.title} — Scalar Commons` : 'Scalar Commons'
    const description = pageData.description || DESCRIPTION
    pageData.frontmatter.head = [
      ...(pageData.frontmatter.head ?? []),
      ['link', { rel: 'canonical', href: url }],
      ['meta', { property: 'og:title', content: title }],
      ['meta', { property: 'og:description', content: description }],
      ['meta', { property: 'og:url', content: url }],
    ]
  },

  markdown: {
    highlight: plainCode,
    codeCopyButtonTitle: 'Copy code',
    // External links open in the same tab (a visitor can middle-click).
    externalLinks: { target: '_self', rel: 'noopener' },
  },

  themeConfig: {
    // The wordmark links to the site home, as the shared header's does.
    logoLink: `${SITE_ORIGIN}/`,
    nav: [
      { text: 'Network', link: `${SITE_ORIGIN}/network`, ...sameSite },
      { text: 'Explorer', link: `${EXPLORER_ORIGIN}/`, ...sameSite },
      { text: 'Docs', link: '/', activeMatch: '/' },
      { text: 'Faucet', link: `${SITE_ORIGIN}/faucet`, ...sameSite },
      { text: 'GitHub', link: REPO, target: '_self', rel: 'noopener' },
    ],
    sidebar,
    outline: { level: [2, 3], label: 'On this page' },
    search: { provider: 'local' },
    docFooter: { prev: 'Previous page', next: 'Next page' },
    externalLinkIcon: true,
    sidebarMenuLabel: 'Menu',
    returnToTopLabel: 'Return to top',
    notFound: {
      code: '404',
      title: 'Page not found',
      quote: 'There is nothing at this address.',
      linkLabel: 'Go to the documentation home',
      linkText: 'Go to the documentation home',
    },
    // The one caption line, as on every other surface; its figures are the snapshot's.
    footer: {
      message: `${DISCLAIMER} Runtime ${snapshot.runtime.specName} ${snapshot.runtime.specVersion}. Figures checked against block ${formatInt(snapshot.provenance.capturedAtBlock)}.`,
    },
  },
})
