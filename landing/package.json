{
  "name": "@scalar-commons/landing",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for Scalar Commons. Every chain figure on a page is generated from runtime metadata read off a live node (chain-facts.json) — nothing is hand-typed. /network reads its figures live in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "fetch:chain-facts": "node scripts/fetch-chain-facts.mjs",
    "verify:chain": "node scripts/verify-chain.mjs",
    "fetch:chain-events": "node scripts/fetch-chain-events.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@polkadot/api": "16.5.6",
    "blakejs": "1.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "25.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
